import { describe, it, expect } from "tish:test"
import { splitFrontmatter, parseYaml, stringifyFrontmatter } from "../src/util/frontmatter.tish"

describe("frontmatter", () => {
  it("splits and parses scalars, arrays, nested maps, block lists", () => {
    let src = "---\ntitle: \"Hello: world\"\ndate: 2026-01-02\ndraft: false\nn: 3\ntags: [a, b, \"c d\"]\nimages:\n  - /x.png\n  - /y.png\nauthor:\n  name: Dev\n  url: https://space.la\nworks:\n  - title: A\n    year: 2010\n  - title: B\n    year: 2011\nbody: |\n  line one\n  line two\nempty:\n---\n\n# Body\n---\nnot frontmatter\n"
    let r = splitFrontmatter(src)
    expect(r.data.title).toBe("Hello: world")
    expect(r.data.date).toBe("2026-01-02")
    expect(r.data.draft).toBe(false)
    expect(r.data.n).toBe(3)
    expect(r.data.tags).toEqual(["a", "b", "c d"])
    expect(r.data.images).toEqual(["/x.png", "/y.png"])
    expect(r.data.author.name).toBe("Dev")
    expect(r.data.works.length).toBe(2)
    expect(r.data.works[1].year).toBe(2011)
    expect(r.data.body).toBe("line one\nline two\n")
    expect(r.data.empty).toBeNull()
    expect(r.content.trim().startsWith("# Body")).toBe(true)
    expect(r.content.indexOf("not frontmatter") > 0).toBe(true)
  })
  it("handles missing frontmatter and json frontmatter", () => {
    expect(splitFrontmatter("# hi").data).toEqual({})
    expect(splitFrontmatter("---\n{\"a\": 1}\n---\nx").data.a).toBe(1)
  })
  it("round-trips", () => {
    let out = stringifyFrontmatter({ title: "A: b", tags: ["x", "y"], n: 2, ok: true }, "body\n")
    let back = splitFrontmatter(out)
    expect(back.data.title).toBe("A: b")
    expect(back.data.tags).toEqual(["x", "y"])
    expect(back.data.n).toBe(2)
    expect(back.data.ok).toBe(true)
    expect(back.content).toBe("body\n")
  })
})
