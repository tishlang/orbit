import { describe, it, expect } from 'tish:test'
import { join, normalize, dirname, basename, extname, relative, stripExt, basePathOf, withBase, stripBase } from '../src/util/path.tish'

describe('path', () => {
  it('joins and normalizes', () => {
    expect(join('a', 'b/', '/c')).toBe('a/b/c')
    expect(join('/a/./b/../c')).toBe('/a/c')
    expect(normalize('a//b')).toBe('a/b')
    expect(join('dist', '/index.html')).toBe('dist/index.html')
  })
  it('splits', () => {
    expect(dirname('/a/b/c.txt')).toBe('/a/b')
    expect(dirname('c.txt')).toBe('.')
    expect(basename('/a/b/c.txt', null)).toBe('c.txt')
    expect(basename('/a/b/c.txt', '.txt')).toBe('c')
    expect(extname('x/y.tar.gz')).toBe('.gz')
    expect(extname('.hidden')).toBe('')
    expect(stripExt('a/b.md')).toBe('a/b')
  })
  it('relative', () => {
    expect(relative('/a/b', '/a/c/d')).toBe('../c/d')
    expect(relative('/a', '/a')).toBe('.')
  })
  it('applies and strips site.basePath', () => {
    expect(basePathOf(null)).toBe('')
    expect(basePathOf({ basePath: '/' })).toBe('')
    expect(basePathOf({ basePath: 'orbit/' })).toBe('/orbit')
    expect(withBase('/orbit', '/docs/')).toBe('/orbit/docs/')
    expect(withBase('/orbit', '/orbit/docs/')).toBe('/orbit/docs/')
    expect(withBase('/orbit', 'https://x.y/')).toBe('https://x.y/')
    expect(withBase('/orbit', '//cdn.x/a.js')).toBe('//cdn.x/a.js')
    expect(withBase('', '/a/')).toBe('/a/')
    expect(stripBase('/orbit', '/orbit')).toBe('/')
    expect(stripBase('/orbit', '/orbit/docs/')).toBe('/docs/')
    expect(stripBase('/orbit', '/orbiter/')).toBe('/orbiter/')
  })
})
