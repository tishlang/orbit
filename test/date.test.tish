import { describe, it, expect } from "tish:test"
import { parseDate, toISO, toISODate, toRFC822, formatDate } from "../src/util/date.tish"

describe("date", () => {
  it("parses ISO dates", () => {
    expect(toISO(parseDate("2026-09-02"))).toBe("2026-09-02T00:00:00Z")
    expect(toISO(parseDate("2026-09-02T10:20:30Z"))).toBe("2026-09-02T10:20:30Z")
    expect(toISO(parseDate("2026-09-02T10:20:30.123+02:00"))).toBe("2026-09-02T08:20:30Z")
    expect(toISO(parseDate("2001-04-05T07:00:00.000Z"))).toBe("2001-04-05T07:00:00Z")
  })
  it("parses RFC-1123 and US formats", () => {
    expect(toISO(parseDate("Wed, 03 Nov 2010 07:00:00 GMT"))).toBe("2010-11-03T07:00:00Z")
    expect(toISODate(parseDate("March 5, 2015"))).toBe("2015-03-05")
    expect(parseDate("garbage")).toBeNull()
    expect(parseDate(null)).toBeNull()
  })
  it("formats", () => {
    let t = parseDate("2026-09-02T10:20:30Z")
    expect(toRFC822(t)).toBe("Wed, 02 Sep 2026 10:20:30 GMT")
    expect(formatDate(t, "MMMM d, yyyy")).toBe("September 2, 2026")
    expect(formatDate(t, "yyyy-MM-dd HH:mm")).toBe("2026-09-02 10:20")
    expect(formatDate(t, null)).toBe("Sep 2, 2026")
  })
})
