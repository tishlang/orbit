// Host-agnostic request handler. req: { method, path, query: {}, headers: {} }
// Returns { status, headers, chunks: [string | Promise<string>] } or { status, headers, body }.
import { matchRoute, matchRedirect } from "../core/router.tish"
import { renderToString, renderToChunks, h, raw } from "../core/render.tish"
import { renderHead } from "../core/seo.tish"
import { islandsIn, islandScripts } from "../core/islands.tish"
import { escapeHtml, escapeAttr } from "../util/html.tish"
import { bySlug, byTag, paginate, allTags, allItems } from "../core/content.tish"

fn has(o, k) { return o !== null && k in o && o[k] !== null }

export fn makeContext(app, req, params, route) {
  let ctx = {
    site: app.site,
    url: req.path,
    path: req.path,
    query: has(req, "query") ? req.query : {},
    headers: has(req, "headers") ? req.headers : {},
    method: has(req, "method") ? req.method : "GET",
    params: params,
    collections: app.content,
    data: app.data,
    dev: app.dev,
    mode: route === null ? null : route.page.render,
    route: route === null ? null : route.path,
    // helpers
    bySlug: bySlug, byTag: byTag, paginate: paginate, allTags: allTags, allItems: allItems,
    islands: [],
    responseHeaders: {},
    status: 200
  }
  return ctx
}

fn mergeHead(layouts, page, ctx, props) {
  let meta = {}
  for (let l of layouts) {
    if (has(l, "head")) {
      let hm = l.head(ctx, props)
      if (hm !== null) { for (let k of Object.keys(hm)) { meta[k] = hm[k] } }
    }
  }
  if (page.head !== null) {
    let pm = page.head(ctx, props)
    if (pm !== null) { for (let k of Object.keys(pm)) { meta[k] = pm[k] } }
  }
  return meta
}

fn applyLayouts(layouts, ctx, tree, props) {
  let t = tree
  let i = layouts.length - 1
  while (i >= 0) {
    let l = layouts[i]
    if (has(l, "layout")) { t = l.layout(ctx, t, props) }
    else if (has(l, "default")) { t = l["default"](ctx, t, props) }
    i = i - 1
  }
  return t
}

export fn documentHead(app, ctx, meta) {
  let site = app.site
  let out = []
  out.push(renderHead(site, ctx.url, meta))
  out.push('<link rel="stylesheet" href="' + escapeAttr(app.css) + '">')
  for (let x of (has(site, "head") ? site.head : [])) { out.push(x) }
  if (Object.keys(app.islands).length > 0) {
    out.push('<script type="module" src="' + app.base + '/islands.js" data-manifest="' + escapeAttr(JSON.stringify(app.islands)) + '"></script>')
  }
  if (app.dev) { out.push('<script src="' + app.base + '/livereload.js" defer></script>') }
  if (has(site, "prefetch") && site.prefetch === true) { out.push('<script src="' + app.base + '/prefetch.js" defer></script>') }
  return out.join("\n")
}

fn htmlAttrs(site, meta) {
  let lang = has(site, "lang") ? site.lang : "en"
  let cls = has(meta, "htmlClass") ? meta.htmlClass : (has(site, "htmlClass") ? site.htmlClass : null)
  return ' lang="' + escapeAttr(lang) + '"' + (cls === null ? "" : ' class="' + escapeAttr(cls) + '"')
}
fn bodyAttrs(site, meta) {
  let cls = has(meta, "bodyClass") ? meta.bodyClass : (has(site, "bodyClass") ? site.bodyClass : null)
  return cls === null ? "" : ' class="' + escapeAttr(cls) + '"'
}

fn textResponse(status, body, type) {
  return { status: status, headers: { "content-type": type === null ? "text/plain; charset=utf-8" : type }, chunks: [body] }
}

export async fn renderRoute(app, route, req, params) {
  let page = route.page
  let ctx = makeContext(app, req, params, route)
  let props = {}
  if (page.load !== null) {
    let r = await page.load(ctx)
    if (r !== null) {
      if (has(r, "redirect")) { return { status: has(r, "status") ? r.status : 302, headers: { location: r.redirect }, chunks: [""] } }
      if (has(r, "notFound") && r.notFound === true) { return await renderNotFound(app, req) }
      if (has(r, "props")) { props = r.props } else { props = r }
      if (has(r, "status")) { ctx.status = r.status }
      if (has(r, "headers")) { for (let k of Object.keys(r.headers)) { ctx.responseHeaders[k.toLowerCase()] = r.headers[k] } }
    }
  }
  if (page.page === null) { return textResponse(500, "orbit: page module exports no `page` function: " + route.file, null) }
  let headers = { "content-type": page.contentType }
  for (let k of Object.keys(ctx.responseHeaders)) { headers[k] = ctx.responseHeaders[k] }
  if (page.headers !== null) { for (let k of Object.keys(page.headers)) { headers[k.toLowerCase()] = page.headers[k] } }
  if (page.render === "isr" && page.revalidate !== null && !has(headers, "cache-control")) {
    headers["cache-control"] = "s-maxage=" + page.revalidate + ", stale-while-revalidate"
  }
  let result = page.page(ctx, props)
  if (result !== null && typeof result === "object" && typeof result.then === "function") { result = await result }
  // Non-HTML pages return a string (feeds, sitemaps, JSON).
  if (typeof result === "string") { return { status: ctx.status, headers: headers, chunks: [result] } }
  let tree = page.layout === false ? result : applyLayouts(route.layouts, ctx, result, props)
  let meta = mergeHead(route.layouts, page, ctx, props)
  let head = documentHead(app, ctx, meta)
  let open = "<!doctype html>\n<html" + htmlAttrs(app.site, meta) + ">\n<head>\n" + head + "\n</head>\n<body" + bodyAttrs(app.site, meta) + ">\n"
  let close = (has(app.site, "bodyEnd") ? app.site.bodyEnd.join("\n") : "") + "\n</body>\n</html>\n"
  if (page.stream) {
    let chunks = renderToChunks(tree)
    let all = [open + chunks[0]]
    let i = 1
    while (i < chunks.length) { all.push(chunks[i]); i = i + 1 }
    all.push(close)
    return { status: ctx.status, headers: headers, chunks: all, stream: true }
  }
  let body = await renderToString(tree)
  return { status: ctx.status, headers: headers, chunks: [open + body + close] }
}

export async fn renderNotFound(app, req) {
  if (app.notFound !== null) {
    let r = await renderRoute(app, app.notFound, req, {})
    r.status = 404
    return r
  }
  return textResponse(404, "Not found: " + req.path, null)
}

export async fn handle(app, req) {
  let path = req.path
  let redirects = has(app.site, "redirects") ? app.site.redirects : []
  let rd = matchRedirect(redirects, path)
  if (rd !== null) { return { status: rd.status, headers: { location: rd.to }, chunks: [""] } }
  // trailing-slash normalization: /blog -> /blog/ (except files)
  if (path.length > 1 && !path.endsWith("/") && path.lastIndexOf(".") < path.lastIndexOf("/")) {
    let m0 = matchRoute(app.routes, path + "/")
    if (m0 !== null && matchRoute(app.routes, path) === null) { return { status: 308, headers: { location: path + "/" }, chunks: [""] } }
  }
  let m = matchRoute(app.routes, path)
  if (m === null) { return await renderNotFound(app, req) }
  return await renderRoute(app, m.route, req, m.params)
}

// Resolve every chunk to a single string (for prerender / non-streaming hosts).
export async fn collect(res) {
  let out = ""
  for (let c of res.chunks) { out = out + (typeof c === "string" ? c : await c) }
  return out
}
