// Frontmatter + a pragmatic YAML subset: scalars, quoted strings, inline arrays,
// block lists (- item), one level of nested maps, block scalars (| and >).
fn scalar(raw) {
  let s = raw.trim()
  if (s === "") { return "" }
  if ((s.startsWith('"') && s.endsWith('"')) || (s.startsWith("'") && s.endsWith("'"))) {
    let inner = s.slice(1, s.length - 1)
    if (s.startsWith('"')) { return inner.replaceAll('\\"', '"').replaceAll("\\n", "\n").replaceAll("\\\\", "\\") }
    return inner.replaceAll("''", "'")
  }
  if (s === "true") { return true }
  if (s === "false") { return false }
  if (s === "null" || s === "~") { return null }
  if (/^-?\d+$/.test(s)) { return parseInt(s, 10) }
  if (/^-?\d+\.\d+$/.test(s)) { return parseFloat(s) }
  if (s.startsWith("[") && s.endsWith("]")) {
    let inner = s.slice(1, s.length - 1).trim()
    if (inner === "") { return [] }
    return splitTop(inner).map(x => scalar(x))
  }
  if (s.startsWith("{") && s.endsWith("}")) {
    let inner = s.slice(1, s.length - 1).trim()
    let o = {}
    if (inner === "") { return o }
    for (let kv of splitTop(inner)) {
      let ci = kv.indexOf(":")
      if (ci > 0) { o[kv.slice(0, ci).trim()] = scalar(kv.slice(ci + 1)) }
    }
    return o
  }
  return s
}
fn splitTop(s) {
  let out = []
  let depth = 0
  let q = null
  let cur = ""
  let i = 0
  while (i < s.length) {
    let c = s.charAt(i)
    if (q !== null) { cur = cur + c; if (c === q) { q = null } }
    else if (c === '"' || c === "'") { q = c; cur = cur + c }
    else if (c === "[" || c === "{") { depth = depth + 1; cur = cur + c }
    else if (c === "]" || c === "}") { depth = depth - 1; cur = cur + c }
    else if (c === "," && depth === 0) { out.push(cur); cur = "" }
    else { cur = cur + c }
    i = i + 1
  }
  if (cur.trim() !== "") { out.push(cur) }
  return out
}
fn indentOf(line) {
  let i = 0
  while (i < line.length && line.charAt(i) === " ") { i = i + 1 }
  return i
}
fn stripComment(line) {
  let q = null
  let i = 0
  while (i < line.length) {
    let c = line.charAt(i)
    if (q !== null) { if (c === q) { q = null } }
    else if (c === '"' || c === "'") { q = c }
    else if (c === "#" && (i === 0 || line.charAt(i - 1) === " ")) { return line.slice(0, i) }
    i = i + 1
  }
  return line
}

export fn parseYaml(text) {
  let lines = text.split("\n").map(l => l.replace(/\r$/, ""))
  let state = { i: 0 }
  return parseMap(lines, state, 0)
}
fn parseMap(lines, st, indent) {
  let o = {}
  while (st.i < lines.length) {
    let rawLine = lines[st.i]
    let line = stripComment(rawLine)
    if (line.trim() === "") { st.i = st.i + 1; continue }
    let ind = indentOf(line)
    if (ind < indent) { return o }
    if (ind > indent) { st.i = st.i + 1; continue }
    let body = line.slice(ind)
    if (body.startsWith("- ")) { return o }
    let ci = body.indexOf(":")
    if (ci < 0) { st.i = st.i + 1; continue }
    let key = body.slice(0, ci).trim().replace(/^["']|["']$/g, "")
    let rest = body.slice(ci + 1)
    let val = rest.trim()
    st.i = st.i + 1
    if (val === "|" || val === ">" || val === "|-" || val === ">-") {
      let block = []
      let bi = -1
      while (st.i < lines.length) {
        let l = lines[st.i]
        if (l.trim() === "") { block.push(""); st.i = st.i + 1; continue }
        let li = indentOf(l)
        if (li <= indent) { break }
        if (bi < 0) { bi = li }
        block.push(l.slice(bi))
        st.i = st.i + 1
      }
      while (block.length > 0 && block[block.length - 1] === "") { block.pop() }
      let txt = val.startsWith(">") ? block.join(" ").replace(/\s+/g, " ") : block.join("\n")
      o[key] = val.endsWith("-") ? txt : txt + "\n"
      continue
    }
    if (val === "") {
      // nested map or block list
      let j = st.i
      while (j < lines.length && stripComment(lines[j]).trim() === "") { j = j + 1 }
      if (j < lines.length) {
        let nl = stripComment(lines[j])
        let ni = indentOf(nl)
        if (ni > indent) {
          st.i = j
          if (nl.slice(ni).startsWith("- ")) { o[key] = parseList(lines, st, ni) }
          else { o[key] = parseMap(lines, st, ni) }
          continue
        }
      }
      o[key] = null
      continue
    }
    o[key] = scalar(val)
  }
  return o
}
fn parseList(lines, st, indent) {
  let arr = []
  while (st.i < lines.length) {
    let line = stripComment(lines[st.i])
    if (line.trim() === "") { st.i = st.i + 1; continue }
    let ind = indentOf(line)
    if (ind < indent) { return arr }
    if (ind > indent) { st.i = st.i + 1; continue }
    let body = line.slice(ind)
    if (!body.startsWith("- ") && body !== "-") { return arr }
    let item = body.slice(2).trim()
    st.i = st.i + 1
    if (item === "") {
      arr.push(parseMap(lines, st, ind + 2))
      continue
    }
    if (item.indexOf(":") > 0 && !item.startsWith("[") && !item.startsWith("{") && !item.startsWith('"') && !item.startsWith("'")) {
      // inline map start: "- key: v" then more keys at indent+2
      let sub = {}
      let ci = item.indexOf(":")
      sub[item.slice(0, ci).trim()] = scalar(item.slice(ci + 1))
      let more = parseMap(lines, st, ind + 2)
      for (let k of Object.keys(more)) { sub[k] = more[k] }
      arr.push(sub)
      continue
    }
    arr.push(scalar(item))
  }
  return arr
}

// splitFrontmatter(src) -> { data, content, raw }
export fn splitFrontmatter(src) {
  let s = src.startsWith("﻿") ? src.slice(1) : src
  let m = /^---[ \t]*\r?\n([\s\S]*?)\r?\n---[ \t]*(?:\r?\n|$)/.exec(s)
  if (m === null) { return { data: {}, content: s, raw: "" } }
  let raw = m[1]
  let data = {}
  if (raw.trim().startsWith("{")) { data = JSON.parse(raw) } else { data = parseYaml(raw) }
  return { data: data, content: s.slice(m[0].length), raw: raw }
}

fn yamlValue(v) {
  if (v === null) { return "null" }
  if (typeof v === "boolean" || typeof v === "number") { return String(v) }
  if (Array.isArray(v)) { return "[" + v.map(x => yamlValue(x)).join(", ") + "]" }
  if (typeof v === "object") { return JSON.stringify(v) }
  let s = String(v)
  if (/^[A-Za-z0-9 _.\/,()'!?-]*$/.test(s) && !/^(true|false|null|~|-?\d+(\.\d+)?)$/.test(s) && s.trim() === s && s !== "" && s.indexOf(": ") < 0 && s.indexOf(" #") < 0) { return s }
  return JSON.stringify(s)
}
export fn stringifyFrontmatter(data, content) {
  let lines = []
  for (let k of Object.keys(data)) {
    let v = data[k]
    if (Array.isArray(v) && v.length > 0 && typeof v[0] === "object" && v[0] !== null) {
      lines.push(k + ":")
      for (let it of v) {
        let ks = Object.keys(it)
        let first = true
        for (let kk of ks) { lines.push((first ? "  - " : "    ") + kk + ": " + yamlValue(it[kk])); first = false }
      }
    } else if (typeof v === "object" && v !== null && !Array.isArray(v)) {
      lines.push(k + ":")
      for (let kk of Object.keys(v)) { lines.push("  " + kk + ": " + yamlValue(v[kk])) }
    } else { lines.push(k + ": " + yamlValue(v)) }
  }
  return "---\n" + lines.join("\n") + "\n---\n" + content
}
