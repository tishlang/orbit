  if (key === "translate-x" && sp !== null) { return "--tw-tx:" + n(sp, neg) + ";transform:translate(var(--tw-tx,0),var(--tw-ty,0)) rotate(var(--tw-r,0)) scale(var(--tw-s,1))" }
  if (key === "translate-y" && sp !== null) { return "--tw-ty:" + n(sp, neg) + ";transform:translate(var(--tw-tx,0),var(--tw-ty,0)) rotate(var(--tw-r,0)) scale(var(--tw-s,1))" }
  if (key === "rotate") { let d = arb !== null ? arb : val + "deg"; return "--tw-r:" + n(d, neg) + ";transform:translate(var(--tw-tx,0),var(--tw-ty,0)) rotate(var(--tw-r,0)) scale(var(--tw-s,1))" }
  if (key === "scale") { let d = arb !== null ? arb : String(parseFloat(val) / 100); return "--tw-s:" + d + ";transform:translate(var(--tw-tx,0),var(--tw-ty,0)) rotate(var(--tw-r,0)) scale(var(--tw-s,1))" }
  if (key === "z") { return "z-index:" + (arb !== null ? arb : n(val, neg)) }
  if (key === "order") { return "order:" + (val === "first" ? "-9999" : (val === "last" ? "9999" : n(val, neg))) }
  if (key === "opacity") { return "opacity:" + (arb !== null ? arb : String(parseFloat(val) / 100)) }
  // typography
  if (key === "text") {
    if (arb !== null && /^(\d|\.|clamp|calc|min\(|max\()/.test(arb)) { return "font-size:" + arb }
    if (val in TEXT) { return "font-size:" + TEXT[val][0] + ";line-height:" + TEXT[val][1] }
    let c = color(val, theme)
    if (c !== null) { return "color:" + c }
    if (arb !== null) { return "font-size:" + arb }
  }
  if (key === "font") {
    if (val in WEIGHT) { return "font-weight:" + WEIGHT[val] }
    if (has(theme.fonts, val)) { return "font-family:" + theme.fonts[val] }
    if (arb !== null) { return "font-family:" + arb }
  }
  if (key === "leading") { if (val in LEADING) { return "line-height:" + LEADING[val] } if (arb !== null) { return "line-height:" + arb } }
  if (key === "tracking") { if (val in TRACKING) { return "letter-spacing:" + TRACKING[val] } if (arb !== null) { return "letter-spacing:" + arb } }
  if (key === "line-clamp") { return "overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:" + val }
  if (key === "indent" && sp !== null) { return "text-indent:" + sp }
  if (key === "decoration") { let c = color(val, theme); if (c !== null) { return "text-decoration-color:" + c } }
  if (key === "placeholder") { let c = color(val, theme); if (c !== null) { return "&::placeholder{color:" + c + "}" } }
  if (key === "list") { if (arb !== null) { return "list-style-type:" + arb } }
  // colors
  if (key === "bg") {
    let c = color(val, theme)
    if (c !== null) { return "background-color:" + c }
    if (arb !== null) { return "background:" + arb }
    if (val === "gradient-to-r") { return "background-image:linear-gradient(to right, var(--tw-gradient-stops))" }
    if (val === "gradient-to-l") { return "background-image:linear-gradient(to left, var(--tw-gradient-stops))" }
    if (val === "gradient-to-t") { return "background-image:linear-gradient(to top, var(--tw-gradient-stops))" }
    if (val === "gradient-to-b") { return "background-image:linear-gradient(to bottom, var(--tw-gradient-stops))" }
    if (val === "gradient-to-br") { return "background-image:linear-gradient(to bottom right, var(--tw-gradient-stops))" }
    if (val === "gradient-to-tr") { return "background-image:linear-gradient(to top right, var(--tw-gradient-stops))" }
  }
  if (key === "from") { let c = color(val, theme); if (c !== null) { return "--tw-gradient-from:" + c + ";--tw-gradient-stops:var(--tw-gradient-from),var(--tw-gradient-to,transparent)" } }
  if (key === "via") { let c = color(val, theme); if (c !== null) { return "--tw-gradient-stops:var(--tw-gradient-from),"+ c + ",var(--tw-gradient-to,transparent)" } }
  if (key === "to") { let c = color(val, theme); if (c !== null) { return "--tw-gradient-to:" + c } }
  if (key === "fill") { let c = color(val, theme); if (c !== null) { return "fill:" + c } }
  if (key === "stroke") { let c = color(val, theme); if (c !== null) { return "stroke:" + c } if (/^\d+$/.test(val)) { return "stroke-width:" + val } }
  if (key === "accent") { let c = color(val, theme); if (c !== null) { return "accent-color:" + c } }
  if (key === "caret") { let c = color(val, theme); if (c !== null) { return "caret-color:" + c } }
  if (key === "outline") { let c = color(val, theme); if (c !== null) { return "outline-color:" + c } if (/^\d+$/.test(val)) { return "outline-width:" + val + "px" } }
  if (key === "ring") { let c = color(val, theme); if (c !== null) { return "--tw-ring-color:" + c + ";box-shadow:0 0 0 var(--tw-ring-w,3px) var(--tw-ring-color)" } if (/^\d+$/.test(val)) { return "--tw-ring-w:" + val + "px;box-shadow:0 0 0 var(--tw-ring-w) var(--tw-ring-color,rgb(59 130 246 / 0.5))" } }
  if (key === "shadow") { if (val in SHADOW) { return "box-shadow:" + SHADOW[val] } let c = color(val, theme); if (c !== null) { return "--tw-shadow-color:" + c } if (arb !== null) { return "box-shadow:" + arb } }
  // borders
  if (key === "border") {
    if (/^\d+$/.test(val)) { return "border-width:" + val + "px" }
    let c = color(val, theme)
    if (c !== null) { return "border-color:" + c }
    if (val.length <= 2 && val in SIDES) { return SIDES[val].map(sd => "border-" + sd + "-width:1px").join(";") }
    let sm = /^([trblxy])-(.+)$/.exec(val)
    if (sm !== null) {
      if (/^\d+$/.test(sm[2])) { return SIDES[sm[1]].map(sd => "border-" + sd + "-width:" + sm[2] + "px").join(";") }
      let cc = color(sm[2], theme)
      if (cc !== null) { return SIDES[sm[1]].map(sd => "border-" + sd + "-color:" + cc).join(";") }
    }
  }
  if (key === "divide") { let c = color(val, theme); if (c !== null) { return "& > :not([hidden]) ~ :not([hidden]){border-color:" + c + "}" } }
  if (key === "rounded") {
    if (val in ROUNDED) { return "border-radius:" + ROUNDED[val] }
    if (arb !== null) { return "border-radius:" + arb }
    let cm = /^(tl|tr|br|bl|t|r|b|l)(?:-(.+))?$/.exec(val)
    if (cm !== null && cm[1] in CORNERS) {
      let r = cm[2] === null ? ROUNDED.DEFAULT : (cm[2] in ROUNDED ? ROUNDED[cm[2]] : arbitrary(cm[2]))
      if (r !== null) { return CORNERS[cm[1]].map(c => "border-" + c + "-radius:" + r).join(";") }
    }
  }
  // grid
  if (key === "grid-cols") { if (/^\d+$/.test(val)) { return "grid-template-columns:repeat(" + val + ", minmax(0, 1fr))" } if (val === "none") { return "grid-template-columns:none" } if (arb !== null) { return "grid-template-columns:" + arb } }
  if (key === "grid-rows") { if (/^\d+$/.test(val)) { return "grid-template-rows:repeat(" + val + ", minmax(0, 1fr))" } if (arb !== null) { return "grid-template-rows:" + arb } }
  if (key === "col-span") { return "grid-column:span " + val + " / span " + val }
  if (key === "row-span") { return "grid-row:span " + val + " / span " + val }
  if (key === "col-start") { return "grid-column-start:" + val }
  if (key === "col-end") { return "grid-column-end:" + val }
  if (key === "row-start") { return "grid-row-start:" + val }
  if (key === "auto-cols") { return "grid-auto-columns:" + (val === "fr" ? "minmax(0, 1fr)" : val) }
  if (key === "auto-rows") { return "grid-auto-rows:" + (val === "fr" ? "minmax(0, 1fr)" : val) }
  // misc
  if (key === "duration") { if (val in DURATION) { return "transition-duration:" + DURATION[val] } if (arb !== null) { return "transition-duration:" + arb } }
  if (key === "delay") { if (val in DURATION) { return "transition-delay:" + DURATION[val] } }
  if (key === "ease") { if (val in EASE) { return "transition-timing-function:" + EASE[val] } if (arb !== null) { return "transition-timing-function:" + arb } }
  if (key === "blur") { if (val in BLUR) { return "filter:blur(" + BLUR[val] + ")" } }
  if (key === "backdrop-blur") { if (val in BLUR) { return "backdrop-filter:blur(" + BLUR[val] + ")" } }
  if (key === "brightness") { return "filter:brightness(" + (parseFloat(val) / 100) + ")" }
  if (key === "grayscale") { return "filter:grayscale(" + val + "%)" }
  if (key === "aspect") { if (arb !== null) { return "aspect-ratio:" + arb } }
  if (key === "columns") { return "columns:" + val }
  if (key === "content") { if (arb !== null) { return "content:" + arb } if (val === "none") { return "content:none" } }
  if (key === "cursor") { return "cursor:" + val }
  if (key === "object") { if (arb !== null) { return "object-position:" + arb } }
  if (key === "will-change") { return "will-change:" + val }
  if (key === "scroll-mt" && sp !== null) { return "scroll-margin-top:" + sp }
  if (key === "scroll-pt" && sp !== null) { return "scroll-padding-top:" + sp }
  if (key === "animate") { if (arb !== null) { return "animation:" + arb } if (has(theme.animations, val)) { return "animation:" + theme.animations[val] } }
  if (key === "flex" && arb !== null) { return "flex:" + arb }
  if (key === "basis" && sp !== null) { return "flex-basis:" + sp }
  if (key === "transition" && arb !== null) { return "transition-property:" + arb + ";transition-timing-function:cubic-bezier(0.4,0,0.2,1);transition-duration:150ms" }
  if (key === "origin" && arb !== null) { return "transform-origin:" + arb }
  return null
}

// Parse "md:hover:bg-red-500" -> { variants: ["md","hover"], utility: "bg-red-500" }
fn parseClass(cls) {
  let parts = []
  let cur = ""
  let depth = 0
  let i = 0
  while (i < cls.length) {
    let c = cls.charAt(i)
    if (c === "[") { depth = depth + 1 }
    if (c === "]") { depth = depth - 1 }
    if (c === ":" && depth === 0) { parts.push(cur); cur = "" } else { cur = cur + c }
    i = i + 1
  }
  parts.push(cur)
  return { variants: parts.slice(0, parts.length - 1), utility: parts[parts.length - 1] }
}

fn wrapVariant(v, sel, body, theme) {
  // returns { sel, body, media } ; body already braces-less declarations or nested "&..." rule
  if (v in SCREENS || has(theme.screens, v)) { return { sel: sel, media: "@media (min-width: " + (has(theme.screens, v) ? theme.screens[v] : SCREENS[v]) + ")" } }
  if (v === "dark") { return { sel: sel, media: has(theme, "darkMode") && theme.darkMode === "class" ? null : "@media (prefers-color-scheme: dark)", prefix: has(theme, "darkMode") && theme.darkMode === "class" ? ".dark " : null } }
  if (v === "motion-reduce") { return { sel: sel, media: "@media (prefers-reduced-motion: reduce)" } }
  if (v === "motion-safe") { return { sel: sel, media: "@media (prefers-reduced-motion: no-preference)" } }
  if (v === "print") { return { sel: sel, media: "@media print" } }
  if (v === "group-hover") { return { sel: sel, prefix: ".group:hover " } }
  if (v === "group-focus") { return { sel: sel, prefix: ".group:focus-within " } }
  if (v === "peer-checked") { return { sel: sel, prefix: ".peer:checked ~ " } }
  if (v === "before") { return { sel: sel + "::before" } }
  if (v === "after") { return { sel: sel + "::after" } }
  if (v === "placeholder") { return { sel: sel + "::placeholder" } }
  if (v === "marker") { return { sel: sel + "::marker" } }
  if (v === "selection") { return { sel: sel + "::selection" } }
  if (v === "first") { return { sel: sel + ":first-child" } }
  if (v === "last") { return { sel: sel + ":last-child" } }
  if (v === "odd") { return { sel: sel + ":nth-child(odd)" } }
  if (v === "even") { return { sel: sel + ":nth-child(even)" } }
  if (v === "focus-visible" || v === "focus-within" || v === "hover" || v === "focus" || v === "active" || v === "visited" || v === "disabled" || v === "checked" || v === "empty" || v === "target") { return { sel: sel + ":" + v } }
  if (v.startsWith("[") && v.endsWith("]")) { return { sel: sel + v.slice(1, v.length - 1) } }
  if (v.startsWith("has-[") && v.endsWith("]")) { return { sel: sel + ":has(" + v.slice(5, v.length - 1) + ")" } }
  if (v.startsWith("aria-")) { return { sel: sel + "[" + v + '="true"]' } }
  if (v.startsWith("data-[") && v.endsWith("]")) { return { sel: sel + "[" + v.slice(6, v.length - 1) + "]" } }
  return null
}

fn variantOrder(v, theme) {
  if (v in SCREENS) { return 100 + 10 * Object.keys(SCREENS).indexOf(v) }
  if (has(theme.screens, v)) { return 100 + 10 * (5 + Object.keys(theme.screens).indexOf(v)) }
  if (v === "dark") { return 5 }
  if (v === "hover") { return 20 }
  if (v === "focus" || v === "focus-visible") { return 21 }
  if (v === "active") { return 22 }
  return 1
}

export fn makeTheme(overrides) {
  let t = { colors: defaultColors(), spacing: {}, fonts: {}, screens: {}, animations: {}, darkMode: "media" }
  if (overrides !== null) {
    for (let k of Object.keys(overrides)) {
      if (k === "colors" || k === "spacing" || k === "fonts" || k === "screens" || k === "animations") {
        for (let kk of Object.keys(overrides[k])) { t[k][kk] = overrides[k][kk] }
      } else { t[k] = overrides[k] }
    }
  }
  return t
}

// Compile one class -> css rule string or null.
export fn compileClass(cls, theme) {
  let pc = parseClass(cls)
  let decl = utility(pc.utility, theme)
  if (decl === null) { return null }
  let sel = "." + esc(cls)
  let media = []
  let prefix = ""
  for (let v of pc.variants) {
    let w = wrapVariant(v, sel, decl, theme)
    if (w === null) { return null }
    sel = w.sel
    if (has(w, "media")) { media.push(w.media) }
    if (has(w, "prefix")) { prefix = w.prefix + prefix }
  }
  sel = prefix + sel
  let rule = ""
  if (decl.startsWith("&")) { rule = decl.replace("&", sel) }
  else { rule = sel + "{" + decl + "}" }
  for (let m of media) { rule = m + "{" + rule + "}" }
  let order = 0
  for (let v of pc.variants) { order = order + variantOrder(v, theme) }
  return { rule: rule, order: order, keyframe: pc.utility.startsWith("animate-") && pc.utility.slice(8) in KEYFRAMES ? KEYFRAMES[pc.utility.slice(8)] : null }
}

// Extract candidate class tokens from source text (HTML, JSX, markdown).
export fn extractClasses(text) {
  let out = {}
  let re = /[A-Za-z][A-Za-z0-9:_\/\.\[\]#%,()!-]*[A-Za-z0-9\]%)]/g
  let m = re.exec(text)
  while (m !== null) {
    let tok = m[0]
    if (tok.length < 2 || tok.length > 80) { m = re.exec(text); continue }
    if (tok.indexOf("[") >= 0 && tok.indexOf("]") < 0) { m = re.exec(text); continue }
    out[tok] = true
    // also negative forms preceded by '-'
    m = re.exec(text)
  }
  let neg = /(?:^|[\s"'`{])(-[a-z][A-Za-z0-9:_\/\.\[\]#-]*)/g
  let nm = neg.exec(text)
  while (nm !== null) { out[nm[1]] = true; nm = neg.exec(text) }
  return Object.keys(out)
}

// generate(sources: string[], themeOverrides) -> css
export fn generate(sources, themeOverrides, includePreflight) {
  let theme = makeTheme(themeOverrides)
  let seen = {}
  let rules = []
  let keyframes = {}
  for (let src of sources) {
    for (let cls of extractClasses(src)) {
      if (cls in seen) { continue }
      seen[cls] = true
      let r = compileClass(cls, theme)
      if (r === null) { continue }
      rules.push(r)
      if (r.keyframe !== null) { keyframes[r.keyframe] = true }
    }
  }
  rules.sort((a, b) => a.order - b.order)
  let out = []
  for (let k of Object.keys(keyframes)) { out.push(k) }
  for (let r of rules) { out.push(r.rule) }
  return out.join("\n")
}

// tw("a b", cond && "c", ["d", null]) -> "a b c d"
export fn tw(...parts) {
  let out = []
  for (let p of parts) {
    if (p === null || p === false || p === true) { continue }
    if (Array.isArray(p)) { out.push(tw(...p)); continue }
    out.push(String(p))
  }
  return out.filter(s => s !== "").join(" ")
}
