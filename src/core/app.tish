// createApp(manifest, opts) builds the route table from the CLI-generated manifest.
import { fileToRoute, sortRoutes } from "./router.tish"
import { normalizePage } from "./page.tish"

fn has(o, k) { return o !== null && k in o && o[k] !== null }

export fn createApp(manifest, opts) {
  let o = opts === null ? {} : opts
  let site = manifest.site
  let routes = []
  let notFound = null
  for (let p of manifest.pages) {
    let r = fileToRoute(p.file)
    let page = normalizePage(p.mod)
    let layouts = has(p, "layouts") ? p.layouts : []
    let entry = { path: r.path, params: r.params, regex: r.regex, depth: r.depth, dynamic: r.dynamic, catchAll: r.catchAll, file: p.file, page: page, layouts: layouts }
    if (r.path === "/404") { notFound = entry; continue }
    routes.push(entry)
  }
  return {
    site: site,
    routes: sortRoutes(routes),
    notFound: notFound,
    content: has(o, "content") ? o.content : {},
    islands: has(o, "islands") ? o.islands : {},
    css: has(o, "css") ? o.css : "/_orbit/styles.css",
    dev: has(o, "dev") ? o.dev === true : false,
    base: has(o, "base") ? o.base : "/_orbit",
    data: has(o, "data") ? o.data : {}
  }
}
