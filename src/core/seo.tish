import { escapeHtml, escapeXml, stripTags } from "../util/html.tish"
import { toRFC822, toISO, parseDate } from "../util/date.tish"

fn opt(o, k, d) { return (o !== null && k in o && o[k] !== null) ? o[k] : d }

export fn absoluteUrl(site, path) {
  if (path === null) { return null }
  if (path.startsWith("http://") || path.startsWith("https://")) { return path }
  let base = opt(site, "url", "").replace(/\/$/, "")
  return base + (path.startsWith("/") ? path : "/" + path)
}

// meta: { title, description, image, canonical, type, noindex, published, modified, author, tags, jsonLd, extra: [html strings] }
export fn renderHead(site, url, meta) {
  let m = meta === null ? {} : meta
  let siteTitle = opt(site, "title", "")
  let title = opt(m, "title", null)
  let fullTitle = title === null ? siteTitle : (opt(m, "titleTemplate", opt(site, "titleTemplate", "%s · " + siteTitle)).replace("%s", title))
  if (opt(m, "rawTitle", false) === true) { fullTitle = title }
  let desc = opt(m, "description", opt(site, "description", ""))
  let canonical = absoluteUrl(site, opt(m, "canonical", url))
  let image = absoluteUrl(site, opt(m, "image", opt(site, "image", null)))
  let type = opt(m, "type", "website")
  let out = []
  out.push('<meta charset="utf-8">')
  out.push('<meta name="viewport" content="width=device-width, initial-scale=1">')
  out.push("<title>" + escapeHtml(fullTitle) + "</title>")
  if (desc !== "") { out.push('<meta name="description" content="' + escapeHtml(stripTags(desc)) + '">') }
  if (canonical !== null) { out.push('<link rel="canonical" href="' + escapeHtml(canonical) + '">') }
  if (opt(m, "noindex", false) === true) { out.push('<meta name="robots" content="noindex, nofollow">') }
  out.push('<meta property="og:type" content="' + escapeHtml(type) + '">')
  out.push('<meta property="og:title" content="' + escapeHtml(title === null ? siteTitle : title) + '">')
  if (desc !== "") { out.push('<meta property="og:description" content="' + escapeHtml(stripTags(desc)) + '">') }
  if (canonical !== null) { out.push('<meta property="og:url" content="' + escapeHtml(canonical) + '">') }
  if (siteTitle !== "") { out.push('<meta property="og:site_name" content="' + escapeHtml(siteTitle) + '">') }
  if (image !== null) { out.push('<meta property="og:image" content="' + escapeHtml(image) + '">') }
  let locale = opt(site, "locale", null)
  if (locale !== null) { out.push('<meta property="og:locale" content="' + escapeHtml(locale) + '">') }
  let published = opt(m, "published", null)
  if (published !== null) { out.push('<meta property="article:published_time" content="' + escapeHtml(published) + '">') }
  let modified = opt(m, "modified", null)
  if (modified !== null) { out.push('<meta property="article:modified_time" content="' + escapeHtml(modified) + '">') }
  for (let t of opt(m, "tags", [])) { out.push('<meta property="article:tag" content="' + escapeHtml(t) + '">') }
  out.push('<meta name="twitter:card" content="' + (image !== null ? "summary_large_image" : "summary") + '">')
  let tw = opt(site, "twitter", null)
  if (tw !== null) { out.push('<meta name="twitter:site" content="' + escapeHtml(tw) + '">') }
  out.push('<meta name="twitter:title" content="' + escapeHtml(title === null ? siteTitle : title) + '">')
  if (desc !== "") { out.push('<meta name="twitter:description" content="' + escapeHtml(stripTags(desc)) + '">') }
  if (image !== null) { out.push('<meta name="twitter:image" content="' + escapeHtml(image) + '">') }
  let themeColor = opt(site, "themeColor", null)
  if (themeColor !== null) { out.push('<meta name="theme-color" content="' + escapeHtml(themeColor) + '">') }
  let icon = opt(site, "icon", null)
  if (icon !== null) { out.push('<link rel="icon" href="' + escapeHtml(icon) + '">') }
  let feeds = opt(site, "feeds", null)
  if (feeds !== null) {
    if (opt(feeds, "rss", null) !== null) { out.push('<link rel="alternate" type="application/rss+xml" title="' + escapeHtml(siteTitle) + '" href="' + escapeHtml(feeds.rss) + '">') }
    if (opt(feeds, "atom", null) !== null) { out.push('<link rel="alternate" type="application/atom+xml" title="' + escapeHtml(siteTitle) + '" href="' + escapeHtml(feeds.atom) + '">') }
  }
  let jsonLd = opt(m, "jsonLd", null)
  if (jsonLd !== null) {
    let list = Array.isArray(jsonLd) ? jsonLd : [jsonLd]
    for (let j of list) { out.push('<script type="application/ld+json">' + JSON.stringify(stripNulls(j)).replaceAll("</", "<\\/") + "</script>") }
  }
  for (let x of opt(m, "extra", [])) { out.push(x) }
  return out.join("\n")
}

// JSON-LD helpers
export fn articleLd(site, item, url) {
  return {
    "@context": "https://schema.org", "@type": "BlogPosting",
    headline: item.title, url: absoluteUrl(site, url),
    datePublished: item.date, dateModified: opt(item.data, "updated", item.date),
    description: item.excerpt, keywords: item.tags.join(", "),
    author: { "@type": "Person", name: opt(site, "author", opt(site, "title", "")) },
    image: item.image === null ? null : absoluteUrl(site, item.image)
  }
}
export fn websiteLd(site) {
  return { "@context": "https://schema.org", "@type": "WebSite", name: opt(site, "title", ""), url: opt(site, "url", "") }
}
export fn personLd(site, extra) {
  let p = { "@context": "https://schema.org", "@type": "Person", name: opt(site, "author", ""), url: opt(site, "url", "") }
  if (extra !== null) { for (let k of Object.keys(extra)) { p[k] = extra[k] } }
  return p
}
export fn breadcrumbLd(site, crumbs) {
  return { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: absoluteUrl(site, c.url) })) }
}

// urls: [{ url, lastmod?, changefreq?, priority? }]
export fn renderSitemap(site, urls) {
  let out = ['<?xml version="1.0" encoding="UTF-8"?>', '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">']
  for (let u of urls) {
    out.push("<url><loc>" + escapeXml(absoluteUrl(site, u.url)) + "</loc>" +
      (opt(u, "lastmod", null) !== null ? "<lastmod>" + escapeXml(u.lastmod) + "</lastmod>" : "") +
      (opt(u, "changefreq", null) !== null ? "<changefreq>" + u.changefreq + "</changefreq>" : "") +
      (opt(u, "priority", null) !== null ? "<priority>" + u.priority + "</priority>" : "") + "</url>")
  }
  out.push("</urlset>")
  return out.join("\n")
}
export fn renderRobots(site, extra) {
  let lines = ["User-agent: *", "Allow: /"]
  if (opt(site, "url", null) !== null) { lines.push("Sitemap: " + absoluteUrl(site, "/sitemap.xml")) }
  for (let l of (extra === null ? [] : extra)) { lines.push(l) }
  return lines.join("\n") + "\n"
}
// items: content items (title, url, date, excerpt/html, tags)
export fn renderRss(site, items, feedUrl) {
  let out = ['<?xml version="1.0" encoding="UTF-8"?>', '<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">', "<channel>"]
  out.push("<title>" + escapeXml(opt(site, "title", "")) + "</title>")
  out.push("<link>" + escapeXml(opt(site, "url", "")) + "</link>")
  out.push("<description>" + escapeXml(opt(site, "description", "")) + "</description>")
  out.push("<language>" + escapeXml(opt(site, "lang", "en")) + "</language>")
  out.push('<atom:link href="' + escapeXml(absoluteUrl(site, feedUrl)) + '" rel="self" type="application/rss+xml"/>')
  let latest = null
  for (let it of items) { if (it.time !== null && (latest === null || it.time > latest)) { latest = it.time } }
  if (latest !== null) { out.push("<lastBuildDate>" + toRFC822(latest) + "</lastBuildDate>") }
  for (let it of items) {
    let link = absoluteUrl(site, it.url)
    out.push("<item><title>" + escapeXml(it.title) + "</title><link>" + escapeXml(link) + "</link><guid isPermaLink=\"true\">" + escapeXml(link) + "</guid>" +
      (it.time !== null ? "<pubDate>" + toRFC822(it.time) + "</pubDate>" : "") +
      "<description>" + escapeXml(it.excerpt) + "</description>" +
      "<content:encoded><![CDATA[" + it.html.replaceAll("]]>", "]]]]><![CDATA[>") + "]]></content:encoded>" +
      it.tags.map(t => "<category>" + escapeXml(t) + "</category>").join("") + "</item>")
  }
  out.push("</channel></rss>")
  return out.join("\n")
}
export fn renderAtom(site, items, feedUrl) {
  let out = ['<?xml version="1.0" encoding="UTF-8"?>', '<feed xmlns="http://www.w3.org/2005/Atom">']
  out.push("<title>" + escapeXml(opt(site, "title", "")) + "</title>")
  out.push('<link href="' + escapeXml(opt(site, "url", "")) + '"/>')
  out.push('<link rel="self" href="' + escapeXml(absoluteUrl(site, feedUrl)) + '"/>')
  out.push("<id>" + escapeXml(opt(site, "url", "")) + "/</id>")
  let latest = null
  for (let it of items) { if (it.time !== null && (latest === null || it.time > latest)) { latest = it.time } }
  out.push("<updated>" + toISO(latest === null ? 0 : latest) + "</updated>")
  out.push("<author><name>" + escapeXml(opt(site, "author", opt(site, "title", ""))) + "</name></author>")
  for (let it of items) {
    let link = absoluteUrl(site, it.url)
    out.push("<entry><title>" + escapeXml(it.title) + "</title><link href=\"" + escapeXml(link) + "\"/><id>" + escapeXml(link) + "</id>" +
      "<updated>" + toISO(it.time === null ? 0 : it.time) + "</updated>" +
      (it.time !== null ? "<published>" + toISO(it.time) + "</published>" : "") +
      "<summary>" + escapeXml(it.excerpt) + "</summary>" +
      '<content type="html">' + escapeXml(it.html) + "</content>" +
      it.tags.map(t => '<category term="' + escapeXml(t) + '"/>').join("") + "</entry>")
  }
  out.push("</feed>")
  return out.join("\n")
}

fn stripNulls(v) {
  if (Array.isArray(v)) { return v.filter(x => x !== null).map(x => stripNulls(x)) }
  if (v !== null && typeof v === "object") {
    let o = {}
    for (let k of Object.keys(v)) { if (v[k] !== null) { o[k] = stripNulls(v[k]) } }
    return o
  }
  return v
}
