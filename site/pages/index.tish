import { island, raw, websiteLd } from '@tishlang/orbit'

export fn head(ctx) {
  return { title: 'Orbit: markdown in, fast sites out', rawTitle: true, description: ctx.site.description, jsonLd: websiteLd(ctx.site) }
}

let FEATURES = [
  ['File-based routing', 'pages/ becomes your routes: [slug] and [...path] segments, nested layouts, redirects and trailing-slash rules.', 'blog/[slug].tish → /blog/:slug'],
  ['Markdown collections', 'Frontmatter, tags, drafts, pagination and prev/next from a folder of .md files.', 'ctx.collections.blog'],
  ['Rendering per route', 'Static HTML at build time, server-rendered per request, or cached and revalidated.', "export let render = 'isr'"],
  ['Streaming', 'The shell flushes at once; slow parts stream in when they resolve.', 'defer(slow(), <Spinner />)'],
  ['Islands', 'JavaScript ships only to the pages that use it, loaded on idle, on view or right away.', "island('chart', props)"],
  ['Tailwind built in', 'Utilities generated from the classes you actually use, with variants and dark mode.', 'class="p-4 dark:bg-slate-900"'],
  ['SEO and feeds', 'Canonical, Open Graph, Twitter, JSON-LD, sitemap.xml, robots.txt, RSS and Atom.', 'orbit build'],
  ['Deploy anywhere', 'Vercel Build Output, a Node server, or any static host, at the root or a sub-path.', 'orbit build --target vercel']
]

// A page file, colored by hand: the site has no client-side highlighter.
let SAMPLE = '<span class="c">// pages/blog/[slug].tish</span>\n'
  + '<span class="k">export let</span> render = <span class="s">\'isr\'</span>\n'
  + '<span class="k">export let</span> revalidate = <span class="s">3600</span>\n\n'
  + '<span class="k">export fn</span> <span class="f">paths</span>(ctx) {\n'
  + '  <span class="k">return</span> ctx.collections.blog.map(p =&gt; ({ params: { slug: p.slug } }))\n'
  + '}\n'
  + '<span class="k">export fn</span> <span class="f">load</span>(ctx) {\n'
  + '  <span class="k">let</span> post = ctx.bySlug(ctx.collections.blog, ctx.params.slug)\n'
  + '  <span class="k">return</span> post === null ? { notFound: true } : { props: { post } }\n'
  + '}\n'
  + '<span class="k">export fn</span> <span class="f">page</span>(ctx, props) {\n'
  + '  <span class="k">return</span> &lt;article&gt;{raw(props.post.html)}&lt;/article&gt;\n'
  + '}'

let INSTALL = 'npx @tishlang/orbit new my-site'

export fn page(ctx) {
  return (
    <div>
      <section class="mx-auto max-w-6xl px-4 pt-12 pb-20 grid gap-12 lg:grid-cols-2 items-center">
        <div>
          <div class="relative w-[120px] h-[120px]">
            <img src={ctx.href('/orbit.svg')} width="120" height="120" alt="The Orbit planet" />
            <span class="moon absolute left-0 top-0 w-[120px] h-[120px]"><span class="absolute left-[2px] top-[54px] w-3 h-3 rounded-full bg-ring-400"></span></span>
          </div>
          <h1 class="wordmark mt-6 text-7xl font-black tracking-tight">Orbit</h1>
          <p class="mt-4 text-3xl font-bold tracking-tight">Markdown in. Fast sites out.</p>
          <p class="mt-4 text-lg text-slate-400 max-w-xl">A web framework written in <a class="text-brand-300 underline" href="https://github.com/tishlang/tish">Tish</a>. You get file-based routes, collections, islands, Tailwind-style utilities, SEO and feeds, and every route can be static, server-rendered or incremental.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={ctx.href('/docs/reference/')} class="rounded-lg bg-brand-500 hover:bg-brand-600 px-5 py-3 font-semibold text-white">Read the docs</a>
            <a href="https://github.com/tishlang/orbit" class="rounded-lg glass hover:border-brand-400 px-5 py-3 font-semibold">GitHub</a>
          </div>
        </div>
        <div class="glass rounded-2xl overflow-hidden shadow-2xl">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10 text-xs text-slate-400 font-mono">
            <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span><span class="w-3 h-3 rounded-full bg-[#febc2e]"></span><span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
            <span class="flex-1 text-center">pages/blog/[slug].tish</span>
          </div>
          <pre class="code p-5 m-0">{raw(SAMPLE)}</pre>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-4 pb-20">
        <p class="font-mono text-sm tracking-widest text-ring-400">WHAT YOU GET</p>
        <h2 class="mt-2 text-4xl font-extrabold tracking-tight">A whole site from one Tish codebase.</h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {FEATURES.map(f => (
            <div class="glass rounded-xl p-5 flex flex-col gap-3">
              <h3 class="text-lg font-bold">{f[0]}</h3>
              <p class="text-sm text-slate-400 flex-1">{f[1]}</p>
              <code class="text-xs text-brand-300 bg-white/5 rounded-md px-2 py-1 self-start">{f[2]}</code>
            </div>
          ))}
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-4 pb-24 grid gap-10 lg:grid-cols-2 items-start">
        <div>
          <p class="font-mono text-sm tracking-widest text-ring-400">GET STARTED</p>
          <h2 class="mt-2 text-4xl font-extrabold tracking-tight">A site in one command.</h2>
          <p class="mt-4 text-slate-400">The starter comes with a blog, an island and a server-rendered page. <code class="text-brand-300">orbit dev</code> reloads as you save.</p>
        </div>
        <div class="glass rounded-2xl p-5 font-mono text-sm space-y-2">
          <div class="flex items-center gap-3"><span class="text-ring-400">$</span><span class="flex-1">{INSTALL}</span>{island('copy', { text: INSTALL }, { load: 'visible' })}</div>
          <div class="flex items-center gap-3"><span class="text-ring-400">$</span><span>{'cd my-site && npm install && npx orbit dev'}</span></div>
          <div class="text-slate-400">orbit dev → <span class="text-brand-300">http://localhost:3000</span></div>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-4 pb-24">
        <div class="glass rounded-2xl p-8 grid gap-6 md:grid-cols-3">
          <div><h3 class="font-bold">Built with Orbit</h3><p class="mt-2 text-sm text-slate-400"><a class="text-brand-300 underline" href="https://space.la">space.la</a> prerenders every screen with Orbit and plays them in a WebGPU island. This site is built with Orbit too.</p></div>
          <div><h3 class="font-bold">Written in Tish</h3><p class="mt-2 text-sm text-slate-400">The same page code runs under <code>tish run</code> for tests and under Node or Vercel in production.</p></div>
          <div><h3 class="font-bold">Open source</h3><p class="mt-2 text-sm text-slate-400">MIT licensed, on <a class="text-brand-300 underline" href="https://github.com/tishlang/orbit">GitHub</a> and <a class="text-brand-300 underline" href="https://www.npmjs.com/package/@tishlang/orbit">npm</a>.</p></div>
        </div>
      </section>
    </div>
  )
}
